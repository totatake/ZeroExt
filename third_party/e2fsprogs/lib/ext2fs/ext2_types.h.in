/*
 * ext2_types.h.in --- fixed-width integer types for ext2fs
 */
#ifndef _EXT2_TYPES_H
#define _EXT2_TYPES_H

#include <stdint.h>

typedef uint8_t   __u8;
typedef int8_t    __s8;
typedef uint16_t  __u16;
typedef int16_t   __s16;
typedef uint32_t  __u32;
typedef int32_t   __s32;
typedef uint64_t  __u64;
typedef int64_t   __s64;

#define EXT2_SIZEOF_SHORT @SIZEOF_SHORT@
#define EXT2_SIZEOF_INT @SIZEOF_INT@
#define EXT2_SIZEOF_LONG @SIZEOF_LONG@
#define EXT2_SIZEOF_LONG_LONG @SIZEOF_LONG_LONG@

#endif /* _EXT2_TYPES_H */
