<Window x:Class="ZeroExt.Gui.Views.ForceUnmountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="残留ドライブレターの強制解除"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="残留ドライブ定義の解除 (zeroext unmount)"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="プロセスが強制終了してエクスプローラーにアクセス不能なドライブレターだけが残ってしまった場合に解除します。マウント時と同じ権限（物理ディスクの場合は管理者権限）で実行してください。"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="解除するドライブレター" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="DriveCombo" IsEditable="True" Text="M:" />
                </StackPanel>
            </Border>

            <Border x:Name="ResultBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardAltBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="閉じる" Style="{StaticResource SecondaryButtonStyle}"
                        Width="95" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="UnmountBtn" Content="ドライブを解除" Style="{StaticResource DangerButtonStyle}"
                        Width="140" Click="OnForceUnmountClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
