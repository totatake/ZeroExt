<Window x:Class="ZeroExt.Gui.Views.WinFspGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_WinFspGuideTitle}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="WinFsp (Windows File System Proxy)" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Border x:Name="StatusPill" Style="{StaticResource PillBadgeStyle}" Margin="12,0,0,0">
                    <TextBlock x:Name="StatusPillText" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </StackPanel>

            <TextBlock Text="{DynamicResource Str_WinFspGuideDesc}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_WinFspMethod1}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 Text="winget install WinFsp.WinFsp" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_CommonCopy}" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="winget install WinFsp.WinFsp" Click="OnCopyCommandClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_WinFspMethod2}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 Text="choco install winfsp" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_CommonCopy}" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="choco install winfsp" Click="OnCopyCommandClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_WinFspMethod3}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Str_WinFspMethod3Desc}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str_WinFspOfficialBtn}" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" Click="OnOpenOfficialSite" />
                        <Button Content="{DynamicResource Str_WinFspGithubBtn}" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnOpenGithubReleases" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,0">
                <TextBlock x:Name="CopyNoticeText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource SuccessBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Str_WinFspRecheckBtn}" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Click="OnRecheckClick" />
                    <Button Content="{DynamicResource Str_CommonClose}" Style="{StaticResource PrimaryButtonStyle}"
                            Width="95" IsCancel="True" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
