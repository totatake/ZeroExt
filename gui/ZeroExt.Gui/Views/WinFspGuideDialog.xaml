<Window x:Class="ZeroExt.Gui.Views.WinFspGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinFsp ランタイム セットアップガイド"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="WinFsp (Windows File System Proxy)" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Border x:Name="StatusPill" Style="{StaticResource PillBadgeStyle}" Margin="12,0,0,0">
                    <TextBlock x:Name="StatusPillText" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </StackPanel>

            <TextBlock Text="Windows のドライブレター（例: M:）や空フォルダとして ext2/3/4 ボリュームをマウントするには、WinFsp ランタイム（Core コンポーネント）のインストールが必要です。未導入の場合でも「ファイルブラウザ」やイメージ作成機能はそのまま利用できます。"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="方法 1: winget でインストール（推奨）" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 Text="winget install WinFsp.WinFsp" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="コピー" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="winget install WinFsp.WinFsp" Click="OnCopyCommandClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="方法 2: Chocolatey でインストール" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" FontFamily="Consolas"
                                 Text="choco install winfsp" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="コピー" Style="{StaticResource SecondaryButtonStyle}"
                                Tag="choco install winfsp" Click="OnCopyCommandClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="方法 3: 公式インストーラ (.msi)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="公式サイトまたは GitHub Releases から最新の winfsp-*.msi をダウンロードし、既定の「Core」構成でインストールしてください（通常再起動不要）。"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="WinFsp 公式サイト" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0" Click="OnOpenOfficialSite" />
                        <Button Content="GitHub Releases" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnOpenGithubReleases" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,0">
                <TextBlock x:Name="CopyNoticeText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource SuccessBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="再検出" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0" Click="OnRecheckClick" />
                    <Button Content="閉じる" Style="{StaticResource PrimaryButtonStyle}"
                            Width="95" IsCancel="True" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
