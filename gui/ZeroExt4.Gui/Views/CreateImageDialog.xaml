<Window x:Class="ZeroExt4.Gui.Views.CreateImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_CreateImgTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource Str_CreateImgHeading}"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="{DynamicResource Str_CreateImgDesc}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_CreateImgPathLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ImagePathBox" Grid.Column="0" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_CommonBrowse}" Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnBrowseClick" />
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_CreateImgSizeLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SizeMbBox" Grid.Column="0" Text="64" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="16 MB" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" Tag="16" Click="OnPresetSizeClick" />
                            <Button Content="64 MB" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" Tag="64" Click="OnPresetSizeClick" />
                            <Button Content="256 MB" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,6,0" Tag="256" Click="OnPresetSizeClick" />
                            <Button Content="1 GB" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Tag="1024" Click="OnPresetSizeClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Str_CreateImgVolLabel}" FontWeight="SemiBold" Margin="0,8,0,6" />
                    <TextBox x:Name="LabelBox" Text="ZEROEXT4" MaxLength="16" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource DangerBgBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelBtn" Content="{DynamicResource Str_CommonCancel}" Style="{StaticResource SecondaryButtonStyle}"
                        Width="100" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="CreateBtn" Content="{DynamicResource Str_CreateImgBtn}" Style="{StaticResource PrimaryButtonStyle}"
                        Width="140" IsDefault="True" Click="OnCreateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
