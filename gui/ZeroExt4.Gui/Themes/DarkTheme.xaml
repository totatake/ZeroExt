<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#162033" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#131C2E" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B263B" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#172133" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#24324B" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#1E3A5F" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#2D3B55" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#233046" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#60A5FA" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A8A" />

    <!-- Semantic Statuses -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#14532D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#451A03" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#450A0A" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="#0C4A6E" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#334155" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#334155" />
</ResourceDictionary>
