<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAFBFD" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardAltBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#EFF6FF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE2EC" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E9EEF5" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#2563EB" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE" />

    <!-- Semantic Statuses -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="InfoBgBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#475569" />
    <SolidColorBrush x:Key="NeutralBgBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E2E8F0" />
</ResourceDictionary>
