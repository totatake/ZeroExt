    <!-- WinFspGuideDialog -->
    <sys:String x:Key="Str_WinFspGuideTitle">WinFsp Runtime Setup Guide</sys:String>
    <sys:String x:Key="Str_WinFspGuideDesc">Mounting ext2/3/4 volumes as a Windows drive letter (e.g. L:) or empty folder requires the WinFsp runtime (Core component). Even without WinFsp, File Browser and image creation remain available.</sys:String>
    <sys:String x:Key="Str_WinFspMethod1">Option 1: Install via winget (Recommended)</sys:String>
    <sys:String x:Key="Str_WinFspMethod2">Option 2: Install via Chocolatey</sys:String>
    <sys:String x:Key="Str_WinFspMethod3">Option 3: Official Installer (.msi)</sys:String>
    <sys:String x:Key="Str_WinFspMethod3Desc">Download the latest winfsp-*.msi from the official site or GitHub Releases and install with the default "Core" component (usually no reboot required).</sys:String>
    <sys:String x:Key="Str_WinFspOfficialBtn">WinFsp Official Site</sys:String>
