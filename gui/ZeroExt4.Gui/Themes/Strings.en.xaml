    <!-- MountErrorTranslator -->
    <sys:String x:Key="Str_ErrOverlayMismatchTitle">Overlay Upperdir Identifier Mismatch</sys:String>
    <sys:String x:Key="Str_ErrOverlayMismatchMsg">The specified NTFS upperdir (.wh.__ext4_lower_id) was previously used with a different ext4 filesystem.</sys:String>
    <sys:String x:Key="Str_ErrOverlayMismatchSug">To prevent data corruption, choose a new empty folder or switch to the matching upperdir.</sys:String>
    <sys:String x:Key="Str_ErrUpperCsNotEmptyTitle">Upperdir Cannot Enable Case Sensitivity (Folder Not Empty)</sys:String>
    <sys:String x:Key="Str_ErrUpperCsNotEmptyMsg">Windows NTFS cannot enable per-directory case sensitivity on an existing non-empty folder. Hidden files created by ZeroExt4 (.wh.__ext4_lower_id, etc.) may still exist even if the folder looks empty in Explorer.</sys:String>
    <sys:String x:Key="Str_ErrUpperCsNotEmptySug">Delete the entire Upperdir folder itself and let ZeroExt4 recreate it, or specify a new folder name (e.g. D:\ext4_upper_cs).</sys:String>
    <sys:String x:Key="Str_ErrUpperCsAccessTitle">Insufficient Permissions for Case-Sensitive Upperdir</sys:String>
    <sys:String x:Key="Str_ErrUpperCsAccessMsg">Windows denied permission to set the NTFS case-sensitivity flag on the Upperdir folder.</sys:String>
    <sys:String x:Key="Str_ErrUpperCsAccessSug">Click "Restart as Admin" at the top right, or pre-enable the flag on an empty NTFS folder as Administrator via: fsutil file setCaseSensitiveInfo &lt;dir&gt; enable</sys:String>
    <sys:String x:Key="Str_ErrUpperCsUnsupportedTitle">Case-Sensitive Upperdir Not Supported on Target Volume</sys:String>
    <sys:String x:Key="Str_ErrUpperCsUnsupportedMsg">The target Upperdir volume does not support NTFS per-directory case sensitivity.</sys:String>
    <sys:String x:Key="Str_ErrUpperCsUnsupportedSug">Specify an empty folder on a local NTFS drive.</sys:String>
    <sys:String x:Key="Str_ErrDirtyRwTitle">Read-Write Mount Denied (Dirty Journal)</sys:String>
    <sys:String x:Key="Str_ErrDirtyRwMsg">An unreplayed JBD2 journal or filesystem error flag was detected on this ext4 volume, so RW mounting was blocked for safety.</sys:String>
    <sys:String x:Key="Str_ErrDirtyRwSug">Use "Read-Only (Recommended)" or "Overlay (Safe RW)" mode, or enable automatic Read-Only fallback on dirty volumes.</sys:String>
    <sys:String x:Key="Str_ErrWinFspTitle">WinFsp Runtime Not Found</sys:String>
    <sys:String x:Key="Str_ErrWinFspMsg">WinFsp (Windows File System Proxy) must be installed to mount as a Windows drive.</sys:String>
    <sys:String x:Key="Str_ErrWinFspSug">Open "WinFsp Guide" at the top right and install WinFsp (winget install WinFsp.WinFsp), then try again. You can still browse files in the "File Browser" tab.</sys:String>
    <sys:String x:Key="Str_ErrMountPointTitle">Mount Target Unavailable</sys:String>
    <sys:String x:Key="Str_ErrMountPointMsg">The selected drive letter may already be in use (including stale drives) or the target folder may not be empty.</sys:String>
    <sys:String x:Key="Str_ErrMountPointSug">Select another available drive letter. If a stale drive letter remains from an earlier crash, use "Force Unmount" in the toolbar.</sys:String>
    <sys:String x:Key="Str_ErrAccessDeniedTitle">Disk Access Denied</sys:String>
    <sys:String x:Key="Str_ErrAccessDeniedMsg">Insufficient permissions to access the physical disk (\\.\PhysicalDriveX) or target path.</sys:String>
    <sys:String x:Key="Str_ErrAccessDeniedSug">Click "Restart as Admin" at the top right before mounting physical disks.</sys:String>
    <sys:String x:Key="Str_ErrOpenFsTitle">Cannot Open Partition or Filesystem</sys:String>
    <sys:String x:Key="Str_ErrOpenFsMsg">Failed to read the source file, partition number, or ext2/3/4 superblock.</sys:String>
    <sys:String x:Key="Str_ErrOpenFsSug">Verify the source path and partition number, then click "Rescan" to refresh.</sys:String>
    <sys:String x:Key="Str_ErrGenericMountTitle">Mount Failed</sys:String>
    <sys:String x:Key="Str_ErrGenericMountMsg">The zeroext4 engine returned an error while mounting.</sys:String>
    <sys:String x:Key="Str_ErrGenericMountSug">Check the "Details &amp; Logs" tab for detailed diagnostics.</sys:String>

    <!-- MountSessionManager & CoreClient -->
    <sys:String x:Key="Str_SessCoreMissingTitle">zeroext4.exe Not Found</sys:String>
    <sys:String x:Key="Str_SessCoreMissingMsg">Could not locate the mount engine zeroext4.exe.</sys:String>
    <sys:String x:Key="Str_SessCoreMissingSug">Build build\zeroext4.exe or set its path in the "Details &amp; Logs" tab.</sys:String>
    <sys:String x:Key="Str_SessStartFailTitle">Process Launch Error</sys:String>
    <sys:String x:Key="Str_SessStartFailMsgFmt">Failed to start zeroext4.exe: {0}</sys:String>
    <sys:String x:Key="Str_SessStartFailSug">Verify file permissions for the executable.</sys:String>
    <sys:String x:Key="Str_SessTimeoutTitle">Mount Timed Out</sys:String>
    <sys:String x:Key="Str_SessTimeoutMsg">zeroext4.exe did not report mount completion within 15 seconds.</sys:String>
    <sys:String x:Key="Str_SessTimeoutSug">Check the "Details &amp; Logs" tab and use "Force Unmount" if a stale drive letter remains.</sys:String>
