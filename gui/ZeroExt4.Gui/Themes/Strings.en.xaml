    <!-- Phase 1 Safety & Diagnostics -->
    <sys:String x:Key="Str_RwHealthBlockedBanner">Direct Read-Write is automatically blocked for this volume's safety. Use Read-Only or non-destructive Overlay mode.</sys:String>
    <sys:String x:Key="Str_ValRwHealthBlocked">Read-Write mode is suppressed because the volume is Dirty, has errors, or uses a read-only/encrypted feature. Select Read-Only or Overlay (or enable --force-dirty for emergency RW).</sys:String>
    <sys:String x:Key="Str_ErrOverlayUnsupportedVerTitle">Unsupported Overlay Marker Version</sys:String>
    <sys:String x:Key="Str_ErrOverlayUnsupportedVerMsg">The specified Upperdir contains a .wh.__ext4_lower_id marker created by a newer format version.</sys:String>
    <sys:String x:Key="Str_ErrOverlayUnsupportedVerSug">Upgrade ZeroExt4 or specify a new empty Upperdir folder.</sys:String>
    <sys:String x:Key="Str_ErrOverlayCorruptTitle">Corrupted Overlay Lower ID Marker</sys:String>
    <sys:String x:Key="Str_ErrOverlayCorruptMsg">The .wh.__ext4_lower_id marker file in the Upperdir is corrupted or unreadable, so Overlay mounting was blocked for safety.</sys:String>
    <sys:String x:Key="Str_ErrOverlayCorruptSug">Specify a new empty Upperdir folder to avoid mixing files across different ext4 volumes.</sys:String>
    <sys:String x:Key="Str_ErrOverlayLegacyRefusedTitle">Non-Empty Unmarked Upperdir Refused</sys:String>
    <sys:String x:Key="Str_ErrOverlayLegacyRefusedMsg">ZeroExt4 refused to use a non-empty folder without a .wh.__ext4_lower_id marker.</sys:String>
    <sys:String x:Key="Str_ErrOverlayLegacyRefusedSug">Specify an empty or new folder so existing Windows files do not shadow the lower ext4 volume.</sys:String>
